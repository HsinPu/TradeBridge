# Docker Compose reads this file automatically; .env can override these defaults.
WEB_PORT=8080
APP_NAME=TradeBridge API
APP_ENV=local
APP_VERSION=1.0.0
APP_BASE_PATH=/tradebridge
LOG_LEVEL=INFO

API_PREFIX=/api/v1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# Local Vite development only: origin without the /tradebridge path.
# Put this in frontend/.env.local if needed.
# Docker builds always use same-origin requests through Nginx.
VITE_API_BASE_URL=http://127.0.0.1:8025

# Compose fixes this path to /app/data/tradebridge.db in its persistent volume.
DATABASE_PATH=./data/tradebridge.db
STORAGE_TIMEZONE=Asia/Taipei

MARKET_DATA_DEFAULT_PROVIDER=binance
MARKET_DATA_RATE_LIMIT_WEIGHT_PER_MINUTE=1200
MARKET_DATA_RETRY_ATTEMPTS=3
MARKET_DATA_COOLDOWN_MS=200
# Manual jobs still execute when the scheduler is disabled.
JOB_MAX_WORKERS=2
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TIMEOUT_SECONDS=10

NOTIFICATION_FAILED_JOB_ENABLED=true
NOTIFICATION_FAILED_JOB_CONSECUTIVE_THRESHOLD=3
NOTIFICATION_FAILED_JOB_PER_MINUTE_LIMIT=60
NOTIFICATION_MISSING_RANGE_ENABLED=true
NOTIFICATION_MISSING_CANDLES_THRESHOLD=200
NOTIFICATION_MISSING_RANGE_PER_MINUTE_LIMIT=60
NOTIFICATION_USAGE_ENABLED=true
NOTIFICATION_USAGE_THRESHOLD_PERCENT=80
NOTIFICATION_USAGE_PER_MINUTE_LIMIT=30
NOTIFICATION_DAILY_REPORT_ENABLED=false
NOTIFICATION_CHANNELS=system
